{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liman",
  "version": "0.3.0",
  "identifier": "com.onuryrlmz.liman",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Liman",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "SSH, SFTP ve terminal için tek liman",
    "category": "DeveloperTool",
    "publisher": "onuryrlmz",
    "copyright": "© 2026 onuryrlmz. Tüm hakları saklıdır.",
    "longDescription": "Liman; sekmeli SSH ve yerel terminal, otomatik açılan SFTP dosya tarayıcısı, oturum yöneticisi ve port tünellerini tek pencerede toplayan, macOS, Windows ve Linux için hafif bir uzak bağlantı istemcisidir.",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
